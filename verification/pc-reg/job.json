{
  "schema_version": 1,
  "name": "pc-reg",
  "build_manifest": "verification/pc-reg/manifest.json",
  "snapshot_inputs": [
    "build.mill",
    "src/main",
    "verification/pc-reg",
    "docs/specs/20-blocks/pipeline/pc-reg.md"
  ],
  "assertions": {
    "mode": "ca_assertion_reviewed_plan",
    "spec": "docs/specs/20-blocks/pipeline/pc-reg.md",
    "plan": "verification/pc-reg/assertion-plan.json",
    "source": "verification/pc-reg/src/main/scala/PCRegVerificationTop.scala"
  },
  "backend": {
    "kind": "verilator",
    "top": "PCRegVerificationTop",
    "testbench": "verification/pc-reg/sim_main.cpp",
    "filelist": "filelist.f",
    "layers": [
      "verification/assert/layers-PCRegVerificationTop-Verification-Assert.sv",
      "verification/cover/layers-PCRegVerificationTop-Verification-Cover.sv"
    ],
    "result_file": "simulation.json",
    "coverage_file": "coverage.dat"
  },
  "mutations": [
    {
      "name": "wrong_increment",
      "file": "PCReg.sv",
      "find": "pcReg + 64'h4",
      "replace": "pcReg + 64'h8",
      "args": [
        "--ltl-only"
      ],
      "expected_assertion": "REQ_PC_003_ADVANCE"
    }
  ]
}
