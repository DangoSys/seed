{
  "schema_version": 1,
  "name": "ifu-protocol",
  "build_manifest": "verification/ifu/manifest.json",
  "snapshot_inputs": [
    "build.mill",
    "src/main",
    "verification/ifu",
    "docs/specs/20-blocks/pipeline/ifu.md",
