{
  "schema_version": 1,
  "name": "idu",
  "build_manifest": "verification/idu/manifest.json",
  "snapshot_inputs": [
    "build.mill",
    "src/main",
    "verification/idu",
    "docs/specs/20-blocks/pipeline/idu.md",
    "docs/verification-plan/idu.md"
  ],
  "assertions": {
    "mode": "ca_assertion_reviewed_plan",
    "spec": "docs/specs/20-blocks/pipeline/idu.md",
    "plan": "verification/idu/assertion-plan.json",
    "source": "verification/idu/src/main/scala/IDUVerificationTop.scala"
  },
  "backend": {
    "kind": "verilator",
    "top": "IDUVerificationTop",
    "testbench": "verification/idu/sim_main.cpp",
    "filelist": "filelist.f",
    "layers": [
      "verification/assert/layers-IDUVerificationTop-Verification-Assert.sv",
      "verification/cover/layers-IDUVerificationTop-Verification-Cover.sv"
    ],
    "result_file": "simulation.json",
    "coverage_file": "coverage.dat"
  },
  "mutations": [
    {
      "name": "drop_decode_valid",
      "file": "IDU.sv",
      "find": "assign io_out_valid = io_in_valid;",
      "replace": "assign io_out_valid = 1'h0;",
      "args": ["--ltl-only"],
      "expected_assertion": "REQ_ID_001_VALID"
    }
  ]
}
