{
  "schema_version": 1,
  "name": "ifid-reg",
  "build_manifest": "verification/ifid-reg/manifest.json",
  "snapshot_inputs": [
    "build.mill",
    "src/main",
    "verification/ifid-reg",
    "docs/specs/20-blocks/pipeline/ifid-reg.md",
    "docs/verification-plan/ifid-reg.md"
  ],
  "assertions": {
    "mode": "ca_assertion_reviewed_plan",
    "spec": "docs/specs/20-blocks/pipeline/ifid-reg.md",
    "plan": "verification/ifid-reg/assertion-plan.json",
    "source": "verification/ifid-reg/src/main/scala/IFIDRegVerificationTop.scala"
  },
  "backend": {
    "kind": "verilator",
    "top": "IFIDRegVerificationTop",
    "testbench": "verification/ifid-reg/sim_main.cpp",
    "filelist": "filelist.f",
    "layers": [
      "verification/assert/layers-IFIDRegVerificationTop-Verification-Assert.sv",
      "verification/cover/layers-IFIDRegVerificationTop-Verification-Cover.sv"
    ],
    "result_file": "simulation.json",
    "coverage_file": "coverage.dat"
  },
  "mutations": [
    {
      "name": "ignore_flush_on_valid",
      "file": "IFIDReg.sv",
      "find": "~io_flush & (io_enable ? io_in_valid : reg_valid)",
      "replace": "(io_enable ? io_in_valid : reg_valid)",
      "args": ["--ltl-only"],
      "expected_assertion": "REQ_IFID_002_PRIORITY"
    }
  ]
}
