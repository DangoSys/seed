//| mill-version: 1.1.10
package build
import mill.*, scalalib.*

object seed extends SbtModule {
  // Sources live at the repo root, not under seed/.
  def moduleDir = super.moduleDir / os.up
  def scalaVersion = "2.13.18"
  def mvnDeps = Seq(mvn"org.chipsalliance::chisel:7.16.0")
  def scalacPluginMvnDeps = Seq(mvn"org.chipsalliance:::chisel-plugin:7.16.0")
  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations")
}

object pcRegVerification extends SbtModule {
  def moduleDir = seed.moduleDir / "verification" / "pc-reg"
  def scalaVersion = seed.scalaVersion()
  def mvnDeps = seed.mvnDeps()
  def scalacPluginMvnDeps = seed.scalacPluginMvnDeps()
  def scalacOptions = seed.scalacOptions()
  def moduleDeps = Seq(seed)
}
